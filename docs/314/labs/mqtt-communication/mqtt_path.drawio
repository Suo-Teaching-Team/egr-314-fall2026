        <mxCell id="94oWR6tL_T3y57ORZ0jl-38" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Step 1&lt;br&gt;&lt;/h1&gt;&lt;p&gt;ESP32 in &quot;loopback&quot; configuration for MQTT messages.&amp;nbsp; Messages sent to its subscribed topic are echoed back to its published topic.&lt;br&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
